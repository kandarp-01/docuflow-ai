{
  "name": "docuflow-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace apps/frontend run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build:frontend": "npm --workspace apps/frontend run build",
    "build:api": "npm --workspace apps/api run build",
    "lint": "npm --workspace apps/frontend run lint",
    "test": "npm --workspace apps/api run test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.3"
  }
}
